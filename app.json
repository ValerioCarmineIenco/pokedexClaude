{
  "expo": {
    "name": "Pokédex",
    "slug": "pokedex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pokedex",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.anonymous.pokedex"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#A11E0A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
      ],
      "package": "com.anonymous.pokedex"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E3350D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sharing",
      "expo-localization",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This permission is only used to show you more relevant ads. The app stays free if you decline."
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Classic",
            "ios": "./assets/images/app-icons/classic.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/classic-foreground.png",
              "backgroundColor": "#E9E6DF"
            }
          },
          {
            "name": "Night",
            "ios": "./assets/images/app-icons/night.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/night-foreground.png",
              "backgroundColor": "#0E0D11"
            }
          },
          {
            "name": "ShinyGold",
            "ios": "./assets/images/app-icons/shinyGold.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/shinyGold-foreground.png",
              "backgroundColor": "#17130B"
            }
          },
          {
            "name": "Retro",
            "ios": "./assets/images/app-icons/retro.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/retro-foreground.png",
              "backgroundColor": "#C3CF98"
            }
          },
          {
            "name": "Spectre",
            "ios": "./assets/images/app-icons/spectre.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/spectre-foreground.png",
              "backgroundColor": "#140D24"
            }
          },
          {
            "name": "Device",
            "ios": "./assets/images/app-icons/device.png",
            "android": {
              "foregroundImage": "./assets/images/app-icons/device-foreground.png",
              "backgroundColor": "#B00C29"
            }
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "en": "./locales/ios/en.json",
      "it": "./locales/ios/it.json",
      "fr": "./locales/ios/fr.json",
      "de": "./locales/ios/de.json",
      "es": "./locales/ios/es.json",
      "ja": "./locales/ios/ja.json"
    }
  }
}
