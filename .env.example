# Copy to .env.local (not committed) or set as EAS environment variables.
# RevenueCat public SDK keys (Project settings > API keys). Without them purchases are simulated.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Web only: SHA-256 (hex) of the preview password. The deploy workflow sets it from the
# WEB_PREVIEW_PASSWORD secret; set it here only to try the unlock in a production web build.
EXPO_PUBLIC_WEB_PREVIEW_PASSWORD_SHA256=
